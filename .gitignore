# Binary2Calendar — Home Assistant custom integration (Python)

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Type checker / lint caches (this project uses .mypy_cache)
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage / test artifacts
.coverage
coverage.xml
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
env/
.env
.env.local

# Packaging / build
*.egg-info/
build/
dist/
*.whl

# IDE / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.Trashes

